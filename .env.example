# Supabase Public API (Accessible by client and Flutter)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role (Server / Edge Functions only - NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (Phase 2 payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase Cloud Messaging (Web Push / Mobile Notifications)
FIREBASE_PROJECT_ID=gyansthali-erp
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gyansthali-erp.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FCM_VAPID_KEY=your-fcm-vapid-public-key
