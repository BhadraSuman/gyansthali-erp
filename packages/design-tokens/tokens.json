{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Gyan Sthali ERP Institutional Design Tokens",
  "version": "1.0.0",
  "colors": {
    "brand": {
      "primary": "#1E3A8A",
      "primaryDark": "#172554",
      "primaryLight": "#3B82F6",
      "primaryContainer": "#1E3A8A",
      "onPrimary": "#FFFFFF",
      "onPrimaryContainer": "#90A8FF",
      "secondary": "#F59E0B",
      "secondaryContainer": "#FEA619",
      "onSecondary": "#FFFFFF",
      "onSecondaryContainer": "#684000"
    },
    "roles": {
      "admin": "#6D28D9",
      "teacher": "#2563EB",
      "parent": "#F59E0B",
      "student": "#16A34A",
      "accountant": "#0D9488"
    },
    "semantic": {
      "success": "#16A34A",
      "successLight": "#DCFCE7",
      "onSuccessLight": "#166534",
      "warning": "#EA580C",
      "warningLight": "#FFEDD5",
      "onWarningLight": "#9A3412",
      "danger": "#DC2626",
      "dangerLight": "#FEE2E2",
      "onDangerLight": "#991B1B",
      "info": "#0EA5E9",
      "infoLight": "#E0F2FE",
      "onInfoLight": "#0369A1"
    },
    "surface": {
      "background": "#F6F7FB",
      "card": "#FFFFFF",
      "subtle": "#F8FAFC",
      "border": "#E2E8F0",
      "borderHover": "#CBD5E1",
      "divider": "#F1F5F9"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#64748B",
      "muted": "#94A3B8",
      "inverse": "#FFFFFF"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": ["Plus Jakarta Sans", "Noto Sans Devanagari", "sans-serif"],
      "body": ["Inter", "Noto Sans Devanagari", "sans-serif"],
      "hindi": ["Noto Sans Devanagari", "sans-serif"]
    },
    "fontSize": {
      "headlineXl": { "size": "36px", "lineHeight": "44px", "fontWeight": "700" },
      "headlineLg": { "size": "30px", "lineHeight": "38px", "fontWeight": "700" },
      "headlineMd": { "size": "22px", "lineHeight": "28px", "fontWeight": "600" },
      "headlineSm": { "size": "18px", "lineHeight": "24px", "fontWeight": "600" },
      "titleMd": { "size": "16px", "lineHeight": "22px", "fontWeight": "600" },
      "bodyLg": { "size": "18px", "lineHeight": "28px", "fontWeight": "400" },
      "bodyMd": { "size": "16px", "lineHeight": "24px", "fontWeight": "400" },
      "bodySm": { "size": "14px", "lineHeight": "20px", "fontWeight": "400" },
      "labelLg": { "size": "15px", "lineHeight": "20px", "fontWeight": "600" },
      "labelMd": { "size": "13px", "lineHeight": "18px", "fontWeight": "600" },
      "labelSm": { "size": "11px", "lineHeight": "16px", "fontWeight": "500", "letterSpacing": "0.05em" }
    }
  },
  "spacing": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "base": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "shadows": {
    "level0": "none",
    "level1": "0 1px 3px 0 rgba(15, 23, 42, 0.05), 0 1px 2px -1px rgba(15, 23, 42, 0.05)",
    "level2": "0 4px 6px -1px rgba(15, 23, 42, 0.07), 0 2px 4px -2px rgba(15, 23, 42, 0.05)",
    "level3": "0 4px 12px 0 rgba(15, 23, 42, 0.06)",
    "level4": "0 20px 25px -5px rgba(15, 23, 42, 0.12), 0 8px 10px -6px rgba(15, 23, 42, 0.08)"
  },
  "touchTarget": {
    "minSize": "48px"
  }
}
